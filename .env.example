# ============================================================
# Novel Agent — AI Writing Assistant for Web Fiction
# ============================================================
# Copy this file to .env and enter your API key to get started.
#
# Pick a provider configuration and uncomment its settings.
#   A. ModelScope (free trial tier with 2,000 requests per day)
#   B. DeepSeek API (about CNY 1 per million output tokens and CNY 5–10 per novel)
#   C. Alibaba Cloud DashScope (official Qwen API, about CNY 4 per million output tokens)
#   D. Anthropic Claude (USD 3 per million input tokens and USD 15 per million output tokens, highest quality)
#   E. Local Ollama (free, requires a GPU)
#
# Set DEFAULT_PROVIDER and DEFAULT_MODEL as the default for all agents.
# Set BUDGET_PROVIDER and BUDGET_MODEL to use less expensive models for review agents.
# ============================================================


# ============================================================
# Option A: ModelScope (free tier)
# ============================================================
# 1. Register at https://modelscope.cn and obtain an SDK token.
# 2. Set OPENAI_API_KEY to your token and use the ModelScope endpoint below.
OPENAI_API_KEY=ms-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
DEFAULT_PROVIDER=modelscope
DEFAULT_MODEL=Qwen/Qwen3-235B-A22B
# BUDGET_MODEL=Qwen/Qwen3-8B  # Optional: use a smaller model for review agents.


# ============================================================
# Option B: DeepSeek API (recommended for cost efficiency)
# ============================================================
# 1. Register at https://platform.deepseek.com and obtain an API key.
# 2. Uncomment the four lines below and set your API key.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=deepseek-chat


# ============================================================
# Option C: Alibaba Cloud DashScope (official Qwen API)
# ============================================================
# 1. Register at https://dashscope.aliyun.com and obtain an API key.
# 2. Uncomment the four lines below and set your API key.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_PROVIDER=dashscope
# DEFAULT_MODEL=qwen-max
# BUDGET_MODEL=qwen-turbo


# ============================================================
# Option D: Anthropic Claude (highest quality, international payment may be required)
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-sonnet-4-20250514
# BUDGET_MODEL=claude-haiku-4-5-20251001


# ============================================================
# Option D2: OpenAI
# ============================================================
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o
# BUDGET_MODEL=gpt-4o-mini


# ============================================================
# Option D3: OpenRouter (one gateway for 200+ models)
# ============================================================
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# DEFAULT_PROVIDER=openrouter
# DEFAULT_MODEL=anthropic/claude-sonnet-4
# BUDGET_MODEL=openai/gpt-4o-mini


# ============================================================
# Option E: Local Ollama (free, requires a GPU)
# ============================================================
# Install from https://ollama.com.
# Pull the model with ollama pull qwen3:32b.
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_PROVIDER=ollama
# DEFAULT_MODEL=qwen3:32b
# BUDGET_MODEL=qwen3:8b


# ============================================================
# Per-agent model overrides (optional)
# ============================================================
# Format: AGENT_TYPE_MODEL=provider:model
# Omit the provider to use DEFAULT_PROVIDER.
#
# Agent responsibilities
#   topic_scout         Market research, concept selection, and title generation
#   architect           Worldbuilding
#   character_manager   Character creation
#   plot_planner        Outline planning
#   writer              Chapter writing (largest token usage, use your best model)
#   editor              Chapter review
#   continuity_checker  Story continuity checks
#   reader_simulator    Reader perspective simulation
#   refiner             Line editing and revision
#   reviewer            Independent adversarial review
#   memory_manager      Foreshadowing and story facts
#   orchestrator        Workflow coordination
#
# Example: Use Claude for writing and independent review, and DeepSeek for editing and continuity.
#   WRITER_MODEL=anthropic:claude-sonnet-4-20250514
#   REVIEWER_MODEL=anthropic:claude-sonnet-4-20250514
#   EDITOR_MODEL=deepseek-chat
#   CONTINUITY_CHECKER_MODEL=deepseek-chat

# TOPIC_SCOUT_MODEL=
# ARCHITECT_MODEL=
# CHARACTER_MANAGER_MODEL=
# PLOT_PLANNER_MODEL=
# WRITER_MODEL=
# EDITOR_MODEL=
# CONTINUITY_CHECKER_MODEL=
# READER_SIMULATOR_MODEL=
# REFINER_MODEL=
# REVIEWER_MODEL=
# MEMORY_MANAGER_MODEL=
# ORCHESTRATOR_MODEL=


# ============================================================
# Basic configuration
# ============================================================
WORKSPACE_ROOT=./workspace
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEFAULT_CHAPTER_WORD_COUNT=3000
MAX_REVIEW_ITERATIONS=3
MIN_REVIEW_SCORE_ACCEPT=6.5
MAX_CONTEXT_CHAPTERS=5
MAX_CONTEXT_FACTS=20
